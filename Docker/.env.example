# ==============================================================================
# Docker（主包镜像）部署配置 —— 复制成 .env 后修改，只需要改这一个文件
#
#   cp .env.example .env
#
# 这个方案跑的是主包 CLI（完整依赖），日志挂到宿主 ./logs。
#
# 容器使用 host 网络（见 docker-compose.yml），因此能看到宿主机的物理网卡，
# 设备号（物理 MAC）拿得到；这也是门户认证能正常工作的前提。
# ==============================================================================

# ---- 本地账号 ----
# 多个学号用分号分隔；每个学号对应一行密码
SHMTU_AUTH_USER_LIST=
#SHMTU_AUTH_USER_PWD_202500000000='你的密码'

# ---- 自建凭据服务（可选，配了就优先用它）----
# 程序会拿容器看到的物理网卡 MAC 当设备号去换账号密码；换不到自动回退上面的本地账号。
# 接口约定见 src/shmtu_auth/config/config.toml 的 [Credential] 段。
# 安全提醒：密码明文过网络，务必 HTTPS + token，别暴露公网。
#SHMTU_AUTH_CREDENTIAL_URL=https://your-server/device/{mac}/credential
#SHMTU_AUTH_CREDENTIAL_TOKEN=
# 服务端用自签名证书时设为 true（会关闭 TLS 校验，尽量别用）
#SHMTU_AUTH_CREDENTIAL_INSECURE=false
# 手动指定设备号（物理网卡 MAC，不是门户 queryString 里那个加密串）
# host 网络下一般不用填；拿不到时日志会明确提示
#SHMTU_AUTH_DEVICE_MAC=

# ---- 检测间隔（秒）----
# 使用主包的检测间隔配置
#SHMTU_AUTH_TIME_INTERVAL=10

# ---- 可选：定死门户接入类型 ----
# 不填则依次尝试「校园网」（有线）和「iSMU」（无线），哪个能通就用哪个。
#SHMTU_AUTH_PORTAL_SERVICE=

# ---- 可选：验证码 OCR ----
# 无头环境没有弹窗兜底，必须保持开启；识别失败只能靠重试，不建议调小次数
#SHMTU_AUTH_CAPTCHA_OCR=true
#SHMTU_AUTH_CAPTCHA_MAX_RETRY=6

# ---- 可选：手动指定 queryString（终极兜底）----
# 配了就跳过自动探测。注意它绑定本机当前 IP，换机器 / 重连后失效。
#SHMTU_AUTH_QUERY_STRING=
